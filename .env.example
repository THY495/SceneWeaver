# Copy to .env locally. Never commit .env or actual API keys.
CHAT_PRODUCT=roleplay
CHAT_MODEL_PROVIDER=deepseek
CHAT_API_BASE=https://api.deepseek.com
CHAT_API_KEY=
CHAT_DIALOGUE_MODEL=deepseek-v4-flash
CHAT_EXPERT_MODEL=deepseek-v4-pro
CHAT_EMBEDDING_PROVIDER=lexical
CHAT_DAILY_BUDGET_USD=6
CHAT_TURN_BUDGET_USD=0.20
CHAT_MAX_CALLS_PER_TASK=48
CHAT_TTS_ENABLED=false
CHAT_TTS_API_KEY=
CHAT_TTS_REGION=ap-southeast-1
CHAT_TTS_TRANSPORT=realtime
CHAT_TTS_REALTIME_MODEL=qwen3-tts-flash-realtime
CHAT_ASR_ENABLED=false
CHAT_ACCESS_TOKEN=
