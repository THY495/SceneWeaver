    "intent": {"act": "speak", "purpose": "回应旅人实际发言", "addressee_id": "player"},
    "sources": {"profile:npc": "你是码头值班员，做事耐心，坚持区分公告、传闻与实际见闻。"},
    "player_request": "沈舟，你在码头做什么工作？",
