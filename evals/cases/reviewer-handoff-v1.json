      "expected_accept": true,
      "expected_expects_reply": true,
      "speech": {
        "text": "你愿意登记吗？",
        "claims": []
      }
    },
    {
      "case_id": "explicit-request",
      "expected_accept": true,
      "expected_expects_reply": true,
      "speech": {
        "text": "请告诉我你是否愿意登记。",
        "claims": []
      }
    },
    {
      "case_id": "acknowledge-only",
      "expected_accept": true,
      "expected_expects_reply": false,
      "speech": {
        "text": "好的，我理解你的意思了。",
        "claims": []
      }
